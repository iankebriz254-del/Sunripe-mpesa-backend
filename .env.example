# ============================================================
# Sun Ripe Poultry Farm — M-Pesa Backend Configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file to version control.
# ============================================================

# --- Server settings ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGIN=http://localhost:5500,https://sunripepoultryfarm.com

# --- Safaricom Daraja API credentials ---
# Get these from https://developer.safaricom.co.ke
# Create an app under "My Apps" to get the Consumer Key/Secret.
MPESA_ENV=sandbox
# ^ "sandbox" while testing, "production" when you go live

MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# --- Till / Shortcode details ---
# Sun Ripe Poultry Farm's M-Pesa Buy Goods till number
MPESA_SHORTCODE=5282328

# Lipa Na M-Pesa Online Passkey — found on the Daraja portal under
# "Lipa Na M-Pesa Sandbox" (test) or issued by Safaricom for production
MPESA_PASSKEY=your_lipa_na_mpesa_online_passkey_here

# Buy Goods till → CustomerBuyGoodsOnline
# Paybill number  → CustomerPayBillOnline
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# --- Callback URL ---
# Must be a PUBLIC HTTPS URL Safaricom can reach — it cannot be localhost.
# Use ngrok (or similar) in development, your real domain in production.
# Example: https://api.sunripepoultryfarm.com/api/mpesa/callback
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# --- Database ---
# Path to the SQLite database file (created automatically on first run)
DATABASE_PATH=./data/sunripe.db
